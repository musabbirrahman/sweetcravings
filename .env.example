# ==============================================================================
# Sweet Cravings Homemade Desserts — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# The app uses its built-in SQLite file (data/sweetcravings.db) with zero
# setup. Leave both values below empty unless you know what you are doing.
#
# Deployment is NOT decided yet. The Turso code and migration script exist
# from the starter, but Turso is NOT wired into the app — the app always
# reads and writes the local SQLite file. Do not deploy to Vercel Hobby for
# this shop: the blueprint warns against it for a commercial order-taking
# site, and a serverless host would not keep the local database file
# between deploys. Decide the deployment shape first, then fill these in.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 2. OPERATOR ADMIN SECURITY
# ------------------------------------------------------------------------------
# Password for the sister / kitchen operator to access /admin.
# - Set a long random password here (or in your hosting provider's env vars).
# - NEVER commit a real password to git, and never share it in chat or docs.
# - If this is empty or missing, admin login is disabled (fails closed).
# - Generate one with: openssl rand -base64 24
#
# HOW TO WRITE IT (this matters — the wrong form silently changes it):
# - ALWAYS wrap the value in SINGLE quotes:
#     ADMIN_PASSWORD='your-password-here'
# - Without quotes, a # in the password cuts the value off at that point,
#   so the password the server checks is shorter than the one you typed
#   and login always fails.
# - NEVER use $ in the password. It is expanded as a variable reference
#   even inside quotes, so the stored value is not what you typed.
# - After creating or changing this file, RESTART the dev server
#   (Ctrl+C, then npm run dev). Passwords are only read when the server
#   starts, so edits made while it runs have no effect until restart.
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. INSTANT TELEGRAM KITCHEN ALERTS (100% Free)
# ------------------------------------------------------------------------------
# Create a free bot via @BotFather on Telegram, paste credentials here or enter
# them through the Admin Settings dashboard (/admin/settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. APP BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
